# Postgres on the VPS
DATABASE_URL=postgres://naces:CHANGE_ME@127.0.0.1:5432/naces
# Where payment slips and other uploads are stored (outside the code folder on the VPS)
UPLOAD_DIR=/var/www/naces-uploads
# First admin account, created by `npm run seed:admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123
ADMIN_NAME=NACES Admin
# Set to true behind HTTPS (production)
COOKIE_SECURE=true
# Bank details shown to members on the Pay page
NEXT_PUBLIC_BANK_NAME=Bank name
NEXT_PUBLIC_ACCOUNT_NAME=NACES ND 2005 / HND 2008 Alumni
NEXT_PUBLIC_ACCOUNT_NUMBER=0000000000
